# Delivery API. Usá un token Preview en local y un token Public en producción.
STORYBLOK_REGION=eu
STORYBLOK_PREVIEW_TOKEN=
STORYBLOK_PUBLIC_TOKEN=

# Obligatorio para una vista previa firmada fuera de localhost y para provisionar.
STORYBLOK_SPACE_ID=

# Configurar solo en el despliegue final. Mantener noindex hasta aprobar su publicación.
SITE_URL=
SITE_INDEXABLE=false

# Opcional: token personal de Management API, solo en local para cms:provision.
# STORYBLOK_MANAGEMENT_TOKEN=
