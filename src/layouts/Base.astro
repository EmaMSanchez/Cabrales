---
import '@fontsource-variable/manrope';
import '@fontsource/yellowtail/latin-400.css';
import '../styles/main.css';
interface Props {
  title: string;
  description: string;
  image?: string;
  indexable?: boolean;
  canonical?: URL;
}
const { title, description, image, indexable = false, canonical } = Astro.props;
const socialImage = image ? new URL(image, canonical ?? Astro.url.origin) : undefined;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eee8de" />
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/media/cabrales-icon.png" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Cabrales" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
